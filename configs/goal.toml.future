name = "Default Xbox Controller"

[ autoload ]
#match_exe_name = ".*"
#match_window_name = ".*"

[ pad ]
# match_controller_name = ".*" # Regex for controller name, defaults to accepting anything
# multi_pad_mode = "duplicate" # Determines how to handle multiple pads
TYPE = "PAD"
N = "XBOX.Y"
S = "XBOX.A"
E = "XBOX.B"
W = "XBOX.X"
BACK = "XBOX.BACK"
GYRO = "AIM.GYRO"

#[ XBOX ]
#TYPE = "XBOX"
#


[ AIM ]
TYPE = "GYRO_TO_MOUSE"
aim_output = "MOUSE"
mode = "PLAYER_TURN"
sens = 3
fast_sens = [5, 4]
slow_threshold = 5
fast_threshold = 75
#smooth_window = 0
smooth_threshold = 5
tightening_theshold = 5
